actions ::= "[" space actions-item ("," space actions-item){0,7} space "]"
actions-item ::= actions-item-0 | actions-item-1 | actions-item-2 | actions-item-3 | actions-item-4 | actions-item-5 | actions-item-6 | actions-item-7 | actions-item-8 | actions-item-9 | actions-item-10 | actions-item-11 | actions-item-12 | actions-item-13 | actions-item-14 | actions-item-15 | actions-item-16
actions-item-0 ::= "{" space actions-item-0-op-kv "," space actions-item-0-name-kv space "}"
actions-item-0-name ::= ref-defs-builtin
actions-item-0-name-kv ::= "\"name\"" space ":" space actions-item-0-name
actions-item-0-op ::= "\"use_profile\""
actions-item-0-op-kv ::= "\"op\"" space ":" space actions-item-0-op
actions-item-1 ::= "{" space actions-item-1-op-kv "," space actions-item-1-name-kv space "}"
actions-item-1-name ::= ref-defs-builtin
actions-item-1-name-kv ::= "\"name\"" space ":" space actions-item-1-name
actions-item-1-op ::= "\"drop_profile\""
actions-item-1-op-kv ::= "\"op\"" space ":" space actions-item-1-op
actions-item-10 ::= "{" space actions-item-10-op-kv "," space actions-item-10-path-kv space "}"
actions-item-10-op ::= "\"read_file\""
actions-item-10-op-kv ::= "\"op\"" space ":" space actions-item-10-op
actions-item-10-path ::= "\"" char{0,256} "\""
actions-item-10-path-kv ::= "\"path\"" space ":" space actions-item-10-path
actions-item-11 ::= "{" space actions-item-11-op-kv "," space actions-item-11-name-kv space "}"
actions-item-11-name ::= "\"" ([a-zA-Z0-9] actions-item-11-name-1{0,63}) "\""
actions-item-11-name-1 ::= [a-zA-Z0-9-]
actions-item-11-name-kv ::= "\"name\"" space ":" space actions-item-11-name
actions-item-11-op ::= "\"name_profile\""
actions-item-11-op-kv ::= "\"op\"" space ":" space actions-item-11-op
actions-item-12 ::= "{" space actions-item-12-op-kv space "}"
actions-item-12-op ::= "\"show\""
actions-item-12-op-kv ::= "\"op\"" space ":" space actions-item-12-op
actions-item-13 ::= "{" space actions-item-13-op-kv space "}"
actions-item-13-op ::= "\"save\""
actions-item-13-op-kv ::= "\"op\"" space ":" space actions-item-13-op
actions-item-14 ::= "{" space actions-item-14-op-kv "," space actions-item-14-code-kv space "}"
actions-item-14-code ::= ref-defs-refusal
actions-item-14-code-kv ::= "\"code\"" space ":" space actions-item-14-code
actions-item-14-op ::= "\"refuse\""
actions-item-14-op-kv ::= "\"op\"" space ":" space actions-item-14-op
actions-item-15 ::= "{" space actions-item-15-op-kv "," space actions-item-15-topic-kv space "}"
actions-item-15-op ::= "\"note\""
actions-item-15-op-kv ::= "\"op\"" space ":" space actions-item-15-op
actions-item-15-topic ::= ref-defs-topic
actions-item-15-topic-kv ::= "\"topic\"" space ":" space actions-item-15-topic
actions-item-16 ::= "{" space actions-item-16-op-kv "," space actions-item-16-question-kv space "}"
actions-item-16-op ::= "\"ask\""
actions-item-16-op-kv ::= "\"op\"" space ":" space actions-item-16-op
actions-item-16-question ::= "\"" char{0,200} "\""
actions-item-16-question-kv ::= "\"question\"" space ":" space actions-item-16-question
actions-item-2 ::= "{" space actions-item-2-op-kv "," space actions-item-2-name-kv space "}"
actions-item-2-name ::= "\"" ([a-zA-Z0-9] actions-item-2-name-1{0,63}) "\""
actions-item-2-name-1 ::= [a-zA-Z0-9-]
actions-item-2-name-kv ::= "\"name\"" space ":" space actions-item-2-name
actions-item-2-op ::= "\"include_profile\""
actions-item-2-op-kv ::= "\"op\"" space ":" space actions-item-2-op
actions-item-3 ::= "{" space actions-item-3-op-kv "," space actions-item-3-path-kv "," space actions-item-3-access-kv space "}"
actions-item-3-access ::= ("\"ro\"" | "\"rw\"" | "\"tmpfs\"")
actions-item-3-access-kv ::= "\"access\"" space ":" space actions-item-3-access
actions-item-3-op ::= "\"grant_path\""
actions-item-3-op-kv ::= "\"op\"" space ":" space actions-item-3-op
actions-item-3-path ::= ref-defs-path
actions-item-3-path-kv ::= "\"path\"" space ":" space actions-item-3-path
actions-item-4 ::= "{" space actions-item-4-op-kv "," space actions-item-4-path-kv space "}"
actions-item-4-op ::= "\"drop_path\""
actions-item-4-op-kv ::= "\"op\"" space ":" space actions-item-4-op
actions-item-4-path ::= ref-defs-path
actions-item-4-path-kv ::= "\"path\"" space ":" space actions-item-4-path
actions-item-5 ::= "{" space actions-item-5-op-kv "," space actions-item-5-host-kv "," space actions-item-5-name-kv space "}"
actions-item-5-host ::= ref-defs-path
actions-item-5-host-kv ::= "\"host\"" space ":" space actions-item-5-host
actions-item-5-name ::= "\"" (actions-item-5-name-1{1,64}) "\""
actions-item-5-name-1 ::= [A-Za-z0-9._+-]
actions-item-5-name-kv ::= "\"name\"" space ":" space actions-item-5-name
actions-item-5-op ::= "\"stage_binary\""
actions-item-5-op-kv ::= "\"op\"" space ":" space actions-item-5-op
actions-item-6 ::= "{" space actions-item-6-op-kv "," space actions-item-6-name-kv "," space actions-item-6-verb-kv ( "," space ( actions-item-6-value-kv ) )? space "}"
actions-item-6-name ::= "\"" ([A-Za-z_] actions-item-6-name-1{0,63}) "\""
actions-item-6-name-1 ::= [A-Za-z0-9_]
actions-item-6-name-kv ::= "\"name\"" space ":" space actions-item-6-name
actions-item-6-op ::= "\"set_env\""
actions-item-6-op-kv ::= "\"op\"" space ":" space actions-item-6-op
actions-item-6-value ::= "\"" char{0,256} "\""
actions-item-6-value-kv ::= "\"value\"" space ":" space actions-item-6-value
actions-item-6-verb ::= ("\"set\"" | "\"inherit\"" | "\"prepend\"")
actions-item-6-verb-kv ::= "\"verb\"" space ":" space actions-item-6-verb
actions-item-7 ::= "{" space actions-item-7-op-kv "," space actions-item-7-name-kv space "}"
actions-item-7-name ::= "\"" ([a-z0-9]+ ("-" [a-z0-9]+)*) "\""
actions-item-7-name-kv ::= "\"name\"" space ":" space actions-item-7-name
actions-item-7-op ::= "\"open_door\""
actions-item-7-op-kv ::= "\"op\"" space ":" space actions-item-7-op
actions-item-8 ::= "{" space actions-item-8-op-kv "," space actions-item-8-kind-kv space "}"
actions-item-8-kind ::= ref-defs-idkind
actions-item-8-kind-kv ::= "\"kind\"" space ":" space actions-item-8-kind
actions-item-8-op ::= "\"list_identities\""
actions-item-8-op-kv ::= "\"op\"" space ":" space actions-item-8-op
actions-item-9 ::= "{" space actions-item-9-op-kv "," space actions-item-9-kind-kv "," space actions-item-9-account-kv space "}"
actions-item-9-account ::= "\"" char{0,128} "\""
actions-item-9-account-kv ::= "\"account\"" space ":" space actions-item-9-account
actions-item-9-kind ::= ref-defs-idkind
actions-item-9-kind-kv ::= "\"kind\"" space ":" space actions-item-9-kind
actions-item-9-op ::= "\"select_identity\""
actions-item-9-op-kv ::= "\"op\"" space ":" space actions-item-9-op
actions-kv ::= "\"actions\"" space ":" space actions
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
ref-defs-builtin ::= ("\"@target-rw\"" | "\"@parent-ro\"" | "\"@git\"" | "\"@net\"" | "\"@claude\"" | "\"@podman-socket\"" | "\"@podman-build\"")
ref-defs-idkind ::= ("\"ssh\"" | "\"github\"" | "\"git\"" | "\"signing\"")
ref-defs-path ::= string
ref-defs-refusal ::= ("\"host_network\"" | "\"host_port\"" | "\"desktop_socket\"" | "\"deny_rule\"" | "\"sensitive_home\"" | "\"whole_home\"" | "\"secret_in_env\"" | "\"docker_sock\"" | "\"port_publish\"" | "\"repo_profile\"" | "\"no_seccomp\"" | "\"out_of_scope\"")
ref-defs-topic ::= ("\"help\"" | "\"profiles\"" | "\"defaults\"" | "\"net\"" | "\"parent_ro\"" | "\"podman_offline\"" | "\"podman_build\"" | "\"port_publish\"" | "\"compose_subdir_volume\"" | "\"secrets_file\"" | "\"identity_one\"" | "\"git\"" | "\"claude\"" | "\"layering\"" | "\"readonly_target\"")
root ::= "{" space actions-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
