#!/bin/sh
# inside-snug — exit 0 ONLY when this shell can prove it is inside a snug
# sandbox. Any other outcome, including "I could not tell", exits non-zero.
#
# WHY THIS EXISTS. An agent working on snug runs on the HOST. Its Bash tool is a
# host shell, always; reaching into a sandbox means passing a command STRING to
# snug, and only that string runs inside. An agent that loses track of the
# distinction for one command does host-side damage while believing it is
# attacking a sandbox. See issue #185.
#
# HOW TO USE IT — in the SAME invocation as the thing it guards:
#
#     snug "$dir" -- sh -c 'bin/inside-snug && rm -rf "$HOME/.config"'
#
# never as two steps. A check that ran earlier in a session proves nothing about
# the shell you are typing into now, and "I verified at the start" is exactly the
# reasoning that fails.
#
# FAIL CLOSED. Every check refuses on error, on an unreadable file, and on
# anything it cannot perform. "I am on the host" and "I could not tell" must
# produce the same exit status, or the guard is worse than nothing — it would be
# a guard that passes precisely when something unexpected is going on.
#
# THREE INDEPENDENT FAMILIES, ALL REQUIRED. Independent means different
# mechanisms, not three readings of one fact:
#
#   A  the environment snug authors      (forgeable — never sufficient alone)
#   B  the filesystem shape              (+ a host canary that must be ABSENT)
#   C  the process tree                  (/proc/1/comm, /proc/1/environ)
#
# NOT A SIGNAL: seccomp. Invariant 5's single exception is that snug WARNS and
# continues when the filter cannot be installed, so requiring `Seccomp: 2` would
# refuse on a host where snug is legitimately running degraded, and accepting its
# absence would weaken the check for everyone else. Do not add it as a family.
#
# NOT A SIGNAL: PS1. snug does author a distinctive prompt, and --dry-run shows
# `--setenv PS1 🔒 snug:\w\$ ` in the argv — but bash UNSETS PS1 when it is not
# interactive, so inside `sh -c` the payload's own /proc/self/environ has no PS1
# at all (measured, issue #185). The one signal CLAUDE.md names for "am I
# inside?" is invisible to the only reader that acts on it programmatically.
# It is a hint for humans at an interactive prompt. It is not evidence.

set -u

canary="${SNUG_HOST_CANARY:-${HOME:-}/.snug-host-canary}"

usage() {
	cat <<'USAGE'
usage: inside-snug [-v]
       inside-snug --install-canary

  (no args)         exit 0 only if provably inside a snug sandbox
  -v                say which checks passed
  --install-canary  create the host canary in $HOME (run on the HOST, once)
USAGE
}

verbose=0
case "${1:-}" in
-v) verbose=1 ;;
--install-canary)
	# The canary is created on the HOST and must never be visible inside. It
	# is the one check whose evidence snug does not produce and a payload
	# cannot manufacture: inside, $HOME is a fresh tmpfs, so the file simply
	# is not there. Note what does NOT work as a negative control —
	# $HOME/.ssh looks like an obvious "must be absent", but the identity
	# machinery GENERATES ~/.ssh/config and known_hosts inside, so it can
	# legitimately exist there.
	if [ -z "${HOME:-}" ]; then
		echo "inside-snug: HOME is unset; refusing to guess where the canary goes" >&2
		exit 1
	fi
	printf '%s\n' "This file exists on the HOST only. bin/inside-snug refuses if it can see it." \
		>"$canary" || exit 1
	echo "inside-snug: host canary written to $canary"
	exit 0
	;;
-h | --help)
	usage
	exit 0
	;;
"") ;;
*)
	usage >&2
	exit 2
	;;
esac

refuse() {
	printf 'inside-snug: NOT inside a snug sandbox (%s)\n' "$1" >&2
	exit 1
}

pass() {
	[ "$verbose" -eq 1 ] && printf 'inside-snug: ok — %s\n' "$1" >&2
	return 0
}

# ── Family A: the environment snug authors ────────────────────────────────
#
# The WEAKEST family, and it is here as a necessary condition only. Environment
# variables are trivially forged, and @sys binds /etc, so /etc/profile.d/* runs
# inside the sandbox and can put variables back (CLAUDE.md). A caller that sets
# SNUG=1 on the host must still be refused, which is what the host-side test
# asserts.
[ -n "${SNUG_PROFILES:-}" ] || refuse "SNUG_PROFILES is unset or empty"
[ "${SNUG:-}" = "1" ] || refuse "SNUG is not 1"
pass "A: snug authored the environment (SNUG_PROFILES=$SNUG_PROFILES)"

# ── Family B: the filesystem shape, plus the host canary ──────────────────
#
# The base state is an empty tmpfs root, and $HOME is one of the tmpfs
# directories that die with the sandbox, so both must report as tmpfs.
root_fs=$(stat -f -c %T / 2>/dev/null) || refuse "cannot stat the filesystem at /"
[ "$root_fs" = tmpfs ] || refuse "/ is $root_fs, and a sandbox root is a tmpfs"

[ -n "${HOME:-}" ] || refuse "HOME is unset, so the home checks cannot run"
home_fs=$(stat -f -c %T "$HOME" 2>/dev/null) || refuse "cannot stat the filesystem at $HOME"
[ "$home_fs" = tmpfs ] || refuse "$HOME is $home_fs, and the sandbox's home is a tmpfs"

# The strongest single test in the guard, and its own positive control: on the
# host the file exists by construction, inside it cannot.
[ ! -e "$canary" ] || refuse "the host canary $canary is visible, so this is the HOST"
pass "B: / and $HOME are tmpfs, and the host canary is not visible"

# ── Family C: the process tree and the namespaces ─────────────────────────
#
# bwrap becomes PID 1 of the sandbox's PID namespace, and snug sets
# cmd.Env = []string{} for it (internal/sandbox/exec.go, netns.go,
# internal/stage/stage.go) — that line exists because PID 1 once leaked 106 host
# variables. So /proc/1/environ is zero bytes here and unreadable on the host,
# and both outcomes are refusals for a host shell.
pid1=$(cat /proc/1/comm 2>/dev/null) || refuse "cannot read /proc/1/comm"
[ "$pid1" = bwrap ] || refuse "PID 1 is $pid1, not bwrap"

environ_bytes=$(wc -c </proc/1/environ 2>/dev/null) || refuse "cannot read /proc/1/environ"
[ "$environ_bytes" -eq 0 ] || refuse "/proc/1/environ is $environ_bytes bytes, not empty"

# WHAT IS NOT CHECKED HERE, AND WHY IT WAS REMOVED RATHER THAN LEFT IN.
#
# An earlier version also required /proc/self/uid_map to map exactly one id and
# /proc/self/setgroups to read `deny`. Both were dropped, for two reasons:
#
#   * Nothing could make either FAIL. Every counterfeit that can be built with
#     bwrap runs in a user namespace, so both hold there as surely as they do in
#     a real sandbox — the integration tests could break the two checks above
#     and see a failure, and could not do the same for these. A check no test can
#     break is a check nobody is reading, and this file is not the place to keep
#     one.
#   * The single-id form carries a false-refusal risk in the dangerous
#     direction. A sandbox that delegates a subuid range — which the container
#     profiles do since Tier B — plausibly maps more than one id, and a guard
#     that refuses INSIDE a real sandbox turns every `inside-snug && <command>`
#     into a silent no-op. That reads as safety and is not. (Unverified here: no
#     engine bundle on this host to measure it against. Stated as the reason the
#     check is not worth its risk, not as a measurement.)
#
# What remains is the pair that a counterfeit can actually break, which is what
# makes family C a family rather than a sentence.
pass "C: PID 1 is bwrap and its environ is empty"

exit 0
